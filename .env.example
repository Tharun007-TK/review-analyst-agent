# Groq API Key: Get this from the Groq console (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. Use llama-3.3-70b-versatile for reliable tool calling.
# llama-3.1-8b-instant often emits malformed <function=...> tool calls and fails with 400 tool_use_failed.
# See all models at: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# SerpApi API Key: Get this from your SerpApi dashboard (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_api_key_here

# OpenRouter API Key: Get this from your OpenRouter account (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
