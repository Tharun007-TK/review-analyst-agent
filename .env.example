# Groq API Key: Get this from the Groq console (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. Pick one with reliable native tool calling.
# Tested options (separate token quotas per model family):
#   openai/gpt-oss-20b           - default, fast, robust tool calls
#   openai/gpt-oss-120b          - bigger, smarter
#   moonshotai/kimi-k2-instruct  - agentic, large context
#   llama-3.3-70b-versatile      - capable but low TPD on free tier
# AVOID: llama-3.1-8b-instant emits malformed <function=...> tool calls (400 tool_use_failed).
# See all models at: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# SerpApi API Key: Get this from your SerpApi dashboard (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_api_key_here

# OpenRouter API Key: Get this from your OpenRouter account (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
